<UserControl x:Class="PCHub.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PCHub.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
            <TextBlock Style="{StaticResource PageTitle}" Text="เครื่องมือ"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="เครื่องมือเล็กๆ ที่ช่วยให้ใช้คอมและเล่นเกมสะดวกขึ้น"/>

            <!-- ===== เช็คปิง ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22"
                                Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" FontSize="18"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        </Border>
                        <Button x:Name="PingButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Center" Click="Ping_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="เช็คปิง"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="เช็คปิงก่อนเล่น"/>
                            <TextBlock x:Name="PingSummary" Style="{StaticResource BodyText}" FontSize="13"
                                       Text="วัดว่าเน็ตบ้านคุณไปถึงเซิร์ฟเวอร์เกมแต่ละโซนเร็วแค่ไหน"/>
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl x:Name="PingList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type views:PingRow}">
                                <Border Padding="12,9" CornerRadius="10" Margin="0,0,0,2" Background="{StaticResource SidebarBg}">
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="2,0,14,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Level, Converter={StaticResource PingBrush}}"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="12.5" Margin="0,0,16,0"
                                                       VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding ValueText}" FontFamily="{StaticResource HeadingFont}"
                                                       FontSize="17" MinWidth="80" TextAlignment="Right"
                                                       Foreground="{Binding Level, Converter={StaticResource PingBrush}}"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Target.Name}" FontSize="14.5"/>
                                            <TextBlock Text="{Binding Target.Detail}" FontSize="12.5" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                               Text="วัดไปยังศูนย์ข้อมูลในเมืองนั้นๆ ซึ่งเป็นที่ตั้งเซิร์ฟเวอร์เกมส่วนใหญ่ ปิงในเกมจริงอาจต่างไปเล็กน้อย  ·  เขียว = ดีมาก (ต่ำกว่า 60 ms)  เหลือง = พอเล่นได้  แดง = หน่วง"/>
                </StackPanel>
            </Border>

            <!-- ===== เครื่องมือที่จะมาเพิ่ม ===== -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0"
                            VerticalAlignment="Top" Background="{StaticResource HoverBg}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="18"
                                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="กำลังจะมา"/>
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="• ดูแอพที่กินแรมเยอะ แล้วกดปิดได้&#10;• ตั้งเวลาปิดเครื่อง&#10;• จัดไฟล์ใน Downloads เข้าโฟลเดอร์ตามประเภท"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
