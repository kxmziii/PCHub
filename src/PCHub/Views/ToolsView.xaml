<UserControl x:Class="PCHub.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
            <TextBlock Style="{StaticResource PageTitle}" Text="เครื่องมือ"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="เครื่องมือเล็กๆ ที่ช่วยให้ใช้คอมสะดวกขึ้น"/>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0"
                            VerticalAlignment="Top" Background="{StaticResource AccentSoft}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="18"
                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="กำลังสร้างหน้านี้"/>
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="• ดูแอพที่กินแรมเยอะ แล้วกดปิดได้&#10;• ตั้งเวลาปิดเครื่อง&#10;• จัดไฟล์ใน Downloads เข้าโฟลเดอร์ตามประเภท"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
