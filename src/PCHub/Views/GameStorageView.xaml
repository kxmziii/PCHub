<UserControl x:Class="PCHub.Views.GameStorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PCHub.Views">
    <DockPanel>
        <!-- พื้นที่แต่ละไดรฟ์ -->
        <ItemsControl x:Name="DriveList" DockPanel.Dock="Top">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type views:DriveItem}">
                    <Border Style="{StaticResource Card}" Width="250" Padding="16,14" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14.5"/>
                            <ProgressBar Maximum="1" Value="{Binding UsedRatio, Mode=OneWay}" Margin="0,10">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- สรุป -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,12,16">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="28"
                        Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="22"
                               Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                </Border>
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="38" Height="38"
                        VerticalAlignment="Center" Content="&#xE72C;" ToolTip="นับใหม่" Click="Refresh_Click"/>
                <StackPanel Margin="18,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryTitle" FontFamily="{StaticResource HeadingFont}" FontSize="22"/>
                    <TextBlock x:Name="SummaryDetail" Style="{StaticResource BodyText}" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <views:StatusToast x:Name="Toast" DockPanel.Dock="Bottom" Margin="0,8,12,0"/>

        <!-- เกมเรียงตามขนาด -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,12,0">
                <ItemsControl x:Name="GameList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type views:GameStorageItem}">
                            <Border Padding="12,8" CornerRadius="10" Margin="0,0,0,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource HoverBg}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <!-- รูปปกเล็ก -->
                                    <Grid DockPanel.Dock="Left" Width="40" Height="60" Margin="0,0,14,0">
                                        <Border CornerRadius="6" Background="{StaticResource SidebarBg}">
                                            <Image Source="{Binding Game.IconPath, Converter={StaticResource PathToIcon}}"
                                                   Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <Border CornerRadius="6">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Game.CoverPath, Converter={StaticResource CoverImage}}"
                                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SizeText}" FontSize="15" MinWidth="80" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <Button Style="{StaticResource GhostDangerButton}" Padding="12,6" Content="ถอนการติดตั้ง"
                                                Click="Uninstall_Click"/>
                                        <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Content="&#xE838;"
                                                ToolTip="เปิดโฟลเดอร์เกม" Click="OpenFolder_Click"/>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Game.Name}" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding LastPlayedText}" FontSize="12.5" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>
    </DockPanel>
</UserControl>
