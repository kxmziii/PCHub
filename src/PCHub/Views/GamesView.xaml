<UserControl x:Class="PCHub.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PCHub.Models"
             xmlns:views="clr-namespace:PCHub.Views">
    <DockPanel>
        <!-- หัวข้อ + ปุ่ม -->
        <Grid DockPanel.Dock="Top" Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="คลังเกม"/>
                <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" Margin="0,0,0,16"
                           Text="เกมจากทุก launcher รวมไว้ที่เดียว"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
                <Button Style="{StaticResource IconButton}" Width="38" Height="38" Margin="0,0,8,0"
                        Content="&#xE72C;" ToolTip="หาเกมใหม่อีกรอบ" Click="Refresh_Click"/>
                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Boost_Click"
                        ToolTip="ตั้งค่าว่ากดเล่นแล้วจะให้เตรียมเครื่องยังไง">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13" Margin="0,0,8,0"
                                   Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="Game Boost"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="AddGame_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock Text="เพิ่มเกม"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ค้นหา + กรองตาม launcher -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,12,10">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="170" Tag="ค้นหาเกม..."
                     VerticalAlignment="Top" TextChanged="SearchBox_TextChanged"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top"
                    Padding="12,7" Margin="0,0,10,0" ToolTip="กดเพื่อเปลี่ยนการเรียง" Click="Sort_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8CB;" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock x:Name="SortText"/>
                </StackPanel>
            </Button>
            <WrapPanel x:Name="ChipPanel" Margin="0,0,16,0">
                <RadioButton x:Name="ChipAll" Style="{StaticResource FilterChip}" Tag="all" IsChecked="True" Checked="Chip_Checked"/>
                <RadioButton x:Name="ChipSteam" Style="{StaticResource FilterChip}" Tag="Steam" Checked="Chip_Checked"/>
                <RadioButton x:Name="ChipEpic" Style="{StaticResource FilterChip}" Tag="Epic" Checked="Chip_Checked"/>
                <RadioButton x:Name="ChipRiot" Style="{StaticResource FilterChip}" Tag="Riot" Checked="Chip_Checked"/>
                <RadioButton x:Name="ChipOther" Style="{StaticResource FilterChip}" Tag="Other" Checked="Chip_Checked"/>
                <RadioButton x:Name="ChipHidden" Style="{StaticResource FilterChip}" Tag="hidden" Checked="Chip_Checked"/>
            </WrapPanel>
        </DockPanel>

        <views:StatusToast x:Name="Toast" DockPanel.Dock="Bottom" Margin="0,8,12,0"/>

        <Grid>
            <TextBlock x:Name="LoadingText" Text="กำลังหาเกมในเครื่อง..." Style="{StaticResource BodyText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Border x:Name="EmptyState" Style="{StaticResource Card}" Margin="0,0,12,0" VerticalAlignment="Top"
                    Visibility="Collapsed">
                <TextBlock x:Name="EmptyText" Style="{StaticResource BodyText}"/>
            </Border>

            <ScrollViewer x:Name="GameScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="GameList" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Game}">
                            <Button Style="{StaticResource GameCard}" Width="150" Margin="0,0,16,20"
                                    Click="Play_Click" MouseRightButtonUp="Card_MouseRightButtonUp">
                                <StackPanel>
                                    <Grid Height="225">
                                        <!-- ชั้นล่าง: ไอคอน + ชื่อ (เห็นเมื่อไม่มีรูปปก) -->
                                        <Border CornerRadius="10" Background="{StaticResource CardBg}"
                                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                            <StackPanel VerticalAlignment="Center" Margin="12">
                                                <Image Source="{Binding IconPath, Converter={StaticResource PathToIcon}}"
                                                       Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                                                           FontSize="13" Margin="0,10,0,0"
                                                           Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- รูปปกเกม -->
                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource CoverImage}}"
                                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <!-- ปุ่มเล่นที่โผล่ตอนเอาเมาส์ชี้ -->
                                        <Border CornerRadius="10" Background="#A0101216">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource Accent}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="20"
                                                           Foreground="{StaticResource AccentText}"
                                                           HorizontalAlignment="Center" Margin="3,0,0,0"/>
                                            </Border>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" Margin="2,10,0,0" FontSize="13.5"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Margin="2,2,0,0" FontSize="12"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
