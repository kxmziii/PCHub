<Window x:Class="PCHub.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Hub" Icon="/Assets/app.ico"
        Width="500" Height="360" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource TextPrimary}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- วงแหวนหมุนรอบโลโก้ -->
                    <DoubleAnimation Storyboard.TargetName="RingRotate" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:1.4" RepeatBehavior="Forever"/>
                    <!-- โลโก้เต้นเบาๆ -->
                    <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.07" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.07" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- แสงเรืองด้านหลังหายใจเข้าออก -->
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                     From="0.45" To="1" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Margin เผื่อที่ให้เงา -->
    <Border Margin="20" CornerRadius="22" BorderBrush="#26FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1C1F2A" Offset="0"/>
                <GradientStop Color="#222A44" Offset="0.6"/>
                <GradientStop Color="#2F4275" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- แสงฟ้าเรืองหลังโลโก้ -->
            <Ellipse x:Name="Glow" Width="230" Height="230" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="0,-6,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#557AA2F7" Offset="0"/>
                        <GradientStop Color="#007AA2F7" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel VerticalAlignment="Top" Margin="0,40,0,0">
                <Grid Width="118" Height="118" HorizontalAlignment="Center">
                    <!-- รางวงแหวน + วงแหวนที่หมุน -->
                    <Ellipse Stroke="#1FFFFFFF" StrokeThickness="3"/>
                    <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeDashArray="36 86"
                             StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="RingRotate"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Image Source="/Assets/logo.png" Width="70" Height="70" RenderTransformOrigin="0.5,0.5"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="LogoScale"/>
                        </Image.RenderTransform>
                    </Image>
                </Grid>
                <TextBlock Text="PC Hub" FontFamily="{StaticResource HeadingFont}" FontSize="30"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="กดทีเดียว เครื่องพร้อมเล่น" FontSize="13.5" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>

            <!-- สถานะ + แถบโหลด -->
            <StackPanel VerticalAlignment="Bottom" Margin="40,0,40,28">
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Right" FontSize="12"
                               Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                               Text="กำลังเริ่ม..."/>
                </DockPanel>
                <ProgressBar x:Name="Progress" Maximum="1" Height="4" Background="#1FFFFFFF"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
