<Window x:Class="PCHub.Views.AddWatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PCHub.Views"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        Title="เฝ้าราคาเกม" Width="620" Height="560">
    <DockPanel Margin="28,22,28,22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource PageTitle}" FontSize="22" Text="เฝ้าราคาเกม"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,14"
                       Text="ค้นหาเกมใน Steam แล้วกดเฝ้า ลดราคาเมื่อไหร่ PC Hub จะแจ้งที่มุมจอ"/>
            <DockPanel Margin="0,0,0,12">
                <Button x:Name="SearchButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        Content="ค้นหา" IsDefault="True" Click="Search_Click"/>
                <TextBox x:Name="SearchBox" Tag="ชื่อเกม เช่น Elden Ring"/>
            </DockPanel>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" Content="เสร็จแล้ว" MinWidth="100"
                HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True"/>

        <Border Style="{StaticResource Card}" Padding="8" Margin="0">
            <Grid>
                <TextBlock x:Name="HintText" Style="{StaticResource BodyText}" FontSize="13" Margin="10"
                           Text="พิมพ์ชื่อเกมแล้วกด Enter"/>
                <ListBox x:Name="ResultList" IsSynchronizedWithCurrentItem="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type views:SearchRow}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="92" Height="34" CornerRadius="4" Margin="0,0,12,0">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding ImageUrl, Converter={StaticResource CoverImage}}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <Button DockPanel.Dock="Right" Padding="12,5" Click="Watch_Click" Content="{Binding ButtonText}"
                                        IsEnabled="{Binding CanAdd}" Style="{StaticResource SecondaryButton}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PriceText}" FontSize="13" Margin="12,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</Window>
