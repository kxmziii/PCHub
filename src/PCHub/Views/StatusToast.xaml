<UserControl x:Class="PCHub.Views.StatusToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Border Style="{StaticResource Card}" Padding="16,10" Margin="0">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="IconText" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
