<UserControl x:Class="PCHub.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PCHub.Views">
    <DockPanel>
        <views:StatusToast x:Name="Toast" DockPanel.Dock="Bottom" Margin="0,8,12,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource PageTitle}" Text="ตั้งค่า"/>
                <TextBlock Style="{StaticResource PageSubtitle}" Text="ปรับการทำงานของ PC Hub"/>

                <!-- ===== เวอร์ชัน + อัปเดต ===== -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="/Assets/logo.png" Width="44" Height="44" Margin="0,0,16,0"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center" Click="Update_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock x:Name="UpdateButtonText" Text="เช็คอัปเดต"/>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource BodyText}" FontSize="13"/>
                            <TextBlock x:Name="MemoryText" FontSize="12.5" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ===== พบปัญหา ===== -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0"
                                VerticalAlignment="Top" Background="{StaticResource AccentSoft}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEBE8;" FontSize="18"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="เจอปัญหา?"/>
                            <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,12"
                                       Text="กดสร้างไฟล์รายงาน แล้วส่งไฟล์ .zip ที่ได้ (อยู่บน Desktop) ให้คนทำ PC Hub ทาง Discord&#10;ในไฟล์มีแค่บันทึกการทำงานกับข้อมูลเครื่อง ไม่มีรหัสผ่านหรือไฟล์ส่วนตัว"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="Report_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="สร้างไฟล์รายงาน"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Content="เปิดโฟลเดอร์บันทึก" Click="OpenLogs_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ===== การทำงานเบื้องหลัง ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="การทำงานเบื้องหลัง"/>
                        <CheckBox x:Name="TraySwitch" Style="{StaticResource Switch}" Margin="0,6"
                                  Checked="Switch_Changed" Unchecked="Switch_Changed">
                            <StackPanel>
                                <TextBlock Text="กดปิด (X) แล้วย่อไปไว้ที่มุมจอ"/>
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextMuted}"
                                           Text="ยังจับเวลาเล่นและอัปเดตเองได้ คลิกไอคอนข้างนาฬิกาเพื่อเปิดกลับ"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Margin="0,6"
                                  Checked="Switch_Changed" Unchecked="Switch_Changed">
                            <StackPanel>
                                <TextBlock Text="เปิด PC Hub พร้อม Windows"/>
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextMuted}"
                                           Text="เปิดเงียบๆ ไว้ที่มุมจอ ไม่เด้งหน้าต่างตอนเปิดเครื่อง"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="ConfirmPlaySwitch" Style="{StaticResource Switch}" Margin="0,6"
                                  Checked="Switch_Changed" Unchecked="Switch_Changed">
                            <StackPanel>
                                <TextBlock Text="ถามก่อนเปิดเกมจากคลังเกม"/>
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextMuted}"
                                           Text="กันกดการ์ดพลาดแล้วเกมเปิด (และ Game Boost ปิดแอพ) ทันที"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="AlertSwitch" Style="{StaticResource Switch}" Margin="0,6"
                                  Checked="Switch_Changed" Unchecked="Switch_Changed">
                            <StackPanel>
                                <TextBlock Text="แจ้งเตือนดีล เกมแจกฟรี และแพตช์ใหม่"/>
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                           Text="เช็คทุก 3 ชั่วโมง แจ้งที่มุมจอเมื่อเกมที่เฝ้าราคาลด, Epic แจกฟรี, เกมที่เพิ่งเล่นมีแพตช์"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="TrackSwitch" Style="{StaticResource Switch}" Margin="0,6"
                                  Checked="Switch_Changed" Unchecked="Switch_Changed">
                            <StackPanel>
                                <TextBlock Text="จับเวลาเล่นอัตโนมัติ"/>
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                           Text="นับเวลาแม้เปิดเกมจาก Steam / Epic โดยตรง (ไม่นับเกมที่ซ่อนไว้) ใช้ทำ Gaming Wrapped"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ===== ที่จะมาเพิ่ม ===== -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0"
                                VerticalAlignment="Top" Background="{StaticResource HoverBg}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="18"
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="กำลังจะมา"/>
                            <TextBlock Style="{StaticResource BodyText}"
                                       Text="• คีย์ลัดสำหรับเปิด PC Hub และเปิดโหมด"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
