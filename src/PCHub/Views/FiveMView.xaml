<UserControl x:Class="PCHub.Views.FiveMView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PCHub.Views">
    <DockPanel>
        <!-- หัวข้อ + ปุ่ม -->
        <Grid DockPanel.Dock="Top" Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="FiveM"/>
                <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" Margin="0,0,0,16"
                           Text="เซิร์ฟไทย จำนวนคนสด ปิง กดเข้าเซิร์ฟได้เลย"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Width="38" Height="38" Margin="0,0,8,0"
                        Content="&#xE72C;" ToolTip="โหลดรายชื่อเซิร์ฟใหม่" Click="Refresh_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Click="OpenFiveM_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock Text="เปิด FiveM"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ล้าง cache -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,12,14">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0"
                        Background="{StaticResource AccentSoft}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{StaticResource Accent}"
                               HorizontalAlignment="Center"/>
                </Border>
                <Button x:Name="ClearCacheButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" Content="ล้าง cache" Click="ClearCache_Click"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CacheTitle" FontSize="14.5" Text="Cache ของ FiveM"/>
                    <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                               Text="ล้างเมื่อเกมเด้ง โหลดค้าง หรือเข้าเซิร์ฟไม่ได้ ไม่ลบไฟล์เกมและข้อมูลล็อกอินในเซิร์ฟ"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ค้นหา + กรอง -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,12,6">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="220" Tag="ค้นหาเซิร์ฟ..."
                     VerticalAlignment="Top" TextChanged="SearchBox_TextChanged"/>
            <WrapPanel>
                <RadioButton x:Name="ChipAll" Style="{StaticResource FilterChip}" Content="เซิร์ฟไทยทั้งหมด"
                             IsChecked="True" Checked="Chip_Checked"/>
                <RadioButton x:Name="ChipFavorites" Style="{StaticResource FilterChip}" Content="ติดดาว"
                             Checked="Chip_Checked"/>
            </WrapPanel>
        </DockPanel>

        <views:StatusToast x:Name="Toast" DockPanel.Dock="Bottom" Margin="0,8,12,0"/>

        <Grid>
            <TextBlock x:Name="LoadingText" Style="{StaticResource BodyText}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Text="กำลังโหลดรายชื่อเซิร์ฟ..."/>
            <Border x:Name="MessageCard" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,12,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}"/>
            </Border>

            <ScrollViewer x:Name="ServerScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,12,0">
                    <ItemsControl x:Name="ServerList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type views:FiveMRow}">
                                <Border Padding="10,8" CornerRadius="10" Margin="0,0,0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource HoverBg}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <!-- ไอคอนเซิร์ฟ -->
                                        <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,14,0">
                                            <Border CornerRadius="10" Background="{StaticResource SidebarBg}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE804;" FontSize="18"
                                                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border CornerRadius="10">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Server.IconUrl, Converter={StaticResource CoverImage}}"
                                                                Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>

                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="6" Padding="8,3" Margin="0,0,10,0" MinWidth="64"
                                                    Background="{StaticResource SidebarBg}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                             Fill="{Binding PingLevel, Converter={StaticResource PingBrush}}"/>
                                                    <TextBlock Text="{Binding PingText}" FontSize="12.5"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                </StackPanel>
                                            </Border>
                                            <Button Style="{StaticResource IconButton}" Margin="0,0,6,0" Click="Favorite_Click"
                                                    Content="{Binding StarGlyph}" ToolTip="ติดดาว / เอาดาวออก">
                                                <Button.Foreground>
                                                    <Binding Path="IsFavorite">
                                                        <Binding.Converter>
                                                            <views:BoolToBrushConverter TrueBrush="{StaticResource Warning}"
                                                                                         FalseBrush="{StaticResource TextMuted}"/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </Button.Foreground>
                                            </Button>
                                            <Button Style="{StaticResource PrimaryButton}" Padding="14,6" Content="เข้าเซิร์ฟ"
                                                    Click="Join_Click"/>
                                        </StackPanel>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Server.Name}" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
                                            <DockPanel Margin="0,5,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding PlayersText}" FontSize="12.5" Width="110"
                                                           Foreground="{StaticResource TextMuted}"/>
                                                <ProgressBar Maximum="1" Value="{Binding FillRatio, Mode=OneWay}" Height="4"
                                                             MaxWidth="220" HorizontalAlignment="Left" Width="220"
                                                             VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
