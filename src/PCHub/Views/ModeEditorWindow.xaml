<Window x:Class="PCHub.Views.ModeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PCHub.Models"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        Width="800" Height="600">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitle}" FontSize="22" Margin="0,0,0,18"/>

        <!-- ชื่อ + ไอคอน -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="ชื่อโหมด"/>
                <TextBox x:Name="NameBox" Tag="เช่น เล่นเกม" MaxLength="40"/>
                <TextBlock x:Name="NameError" Text="ใส่ชื่อโหมดก่อนนะ" FontSize="12" Margin="2,4,0,0"
                           Foreground="{StaticResource Danger}" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="28,0,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="ไอคอน"/>
                <ListBox x:Name="IconList" ItemContainerStyle="{StaticResource IconChoiceItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding}" FontSize="17"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>

        <!-- ซ้าย: แอพในโหมด / ขวา: แอพในเครื่อง -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0">
                <DockPanel>
                    <TextBlock x:Name="SelectedHeader" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                               FontSize="15" Margin="6,0,0,10"/>
                    <Grid>
                        <ListBox x:Name="SelectedList">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:AppEntry}">
                                    <DockPanel>
                                        <Image DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,10,0"
                                               Source="{Binding Path, Converter={StaticResource PathToIcon}}"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Width="28" Height="28" FontSize="11" Content="&#xE711;"
                                                ToolTip="เอาออกจากโหมด" Click="RemoveApp_Click"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource BodyText}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   Text="ยังไม่มีแอพ&#10;เลือกจากลิสต์ด้านขวาได้เลย"/>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" FontSize="15"
                               Margin="6,0,0,10" Text="แอพในเครื่อง"/>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Tag="ค้นหาแอพ..." Margin="0,0,0,10"
                             TextChanged="SearchBox_TextChanged"/>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                            Click="BrowseFile_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="ไม่เจอ? เลือกไฟล์เอง..."/>
                        </StackPanel>
                    </Button>
                    <ListBox x:Name="InstalledList" MouseDoubleClick="InstalledList_MouseDoubleClick"
                             IsSynchronizedWithCurrentItem="False" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AppEntry}">
                                <DockPanel>
                                    <Image DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,10,0"
                                           Source="{Binding Path, Converter={StaticResource PathToIcon}}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                            Width="28" Height="28" FontSize="12" Content="&#xE710;"
                                            Foreground="{StaticResource Accent}"
                                            ToolTip="เพิ่มเข้าโหมด" Click="AddApp_Click"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ปุ่มล่าง -->
        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <Button x:Name="DeleteButton" Style="{StaticResource GhostDangerButton}" Click="Delete_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock Text="ลบโหมดนี้"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="ยกเลิก" MinWidth="100"
                        Margin="0,0,10,0" IsCancel="True"/>
                <Button Style="{StaticResource PrimaryButton}" Content="บันทึก" MinWidth="100"
                        Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
