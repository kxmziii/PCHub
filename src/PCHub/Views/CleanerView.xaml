<UserControl x:Class="PCHub.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PCHub.Models"
             xmlns:views="clr-namespace:PCHub.Views">
    <DockPanel>
        <!-- หัวข้อ + แท็บ -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,12,0">
            <TextBlock Style="{StaticResource PageTitle}" Text="ลบขยะ &amp; พื้นที่"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,14"
                       Text="ทำให้เครื่องโล่ง ดูให้ก่อนเสมอ ไม่ลบอะไรโดยไม่ถาม"/>
            <WrapPanel Margin="0,0,0,8">
                <RadioButton x:Name="TabJunk" Style="{StaticResource FilterChip}" Content="ไฟล์ขยะ" IsChecked="True"
                             Checked="Tab_Checked"/>
                <RadioButton x:Name="TabStorage" Style="{StaticResource FilterChip}" Content="พื้นที่เกม"
                             Checked="Tab_Checked"/>
            </WrapPanel>
        </StackPanel>

        <Grid>
            <!-- ===== แท็บไฟล์ขยะ ===== -->
            <DockPanel x:Name="JunkPanel">
                <!-- การ์ดสรุป: พบขยะเท่าไหร่ + ปุ่มสแกน/ลบ -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,12,16">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="28"
                                Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="22"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        </Border>
                        <Button x:Name="CleanButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Center" Margin="10,0,0,0" IsEnabled="False" Click="Clean_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock x:Name="CleanButtonText" Text="ลบที่เลือก"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ScanButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center" Margin="16,0,0,0" Click="Scan_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="สแกน"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SummaryTitle" FontFamily="{StaticResource HeadingFont}" FontSize="22"/>
                            <TextBlock x:Name="SummaryDetail" Style="{StaticResource BodyText}" FontSize="13" Margin="0,2,0,0"/>
                            <ProgressBar x:Name="Progress" Maximum="1" Margin="0,10,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- หมวดขยะ (กดตรงไหนของแถวก็ติ๊กได้) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,12,0">
                        <ItemsControl x:Name="CategoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:CleanupCategory}">
                                    <CheckBox IsChecked="{Binding IsSelected}" Padding="12,10" Margin="0,0,0,2">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19"
                                                    Background="{StaticResource SidebarBg}">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}"
                                                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="15"
                                                       MinWidth="90" TextAlignment="Right" VerticalAlignment="Center"
                                                       Margin="12,0,4,0"/>
                                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14.5"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </ScrollViewer>
            </DockPanel>

            <!-- ===== แท็บพื้นที่เกม ===== -->
            <views:GameStorageView x:Name="StoragePanel" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
