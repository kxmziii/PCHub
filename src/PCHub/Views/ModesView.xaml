<UserControl x:Class="PCHub.Views.ModesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PCHub.Models"
             xmlns:views="clr-namespace:PCHub.Views">
    <DockPanel>
        <!-- หัวข้อ + ปุ่มสร้างโหมด -->
        <Grid DockPanel.Dock="Top" Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="โหมด &amp; เปิดแอพ"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="กดเปิดทั้งหมดเพื่อเปิดทุกแอพในโหมด หรือกดไอคอนแอพเพื่อเปิดทีละตัว"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top"
                    Margin="16,4,0,0" Click="AddMode_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="สร้างโหมดใหม่"/>
                </StackPanel>
            </Button>
        </Grid>

        <views:StatusToast x:Name="Toast" DockPanel.Dock="Bottom" Margin="0,8,12,0"/>

        <!-- การ์ดโหมด -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ModeList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:LaunchMode}">
                        <Border Style="{StaticResource Card}" Width="300" Margin="0,0,16,16">
                            <DockPanel>
                                <!-- หัวการ์ด: ไอคอน ชื่อ จำนวนแอพ ปุ่มแก้ไข -->
                                <DockPanel DockPanel.Dock="Top">
                                    <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22"
                                            Background="{StaticResource AccentSoft}">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="18"
                                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE70F;"
                                            VerticalAlignment="Top" ToolTip="แก้ไขโหมด" Click="EditMode_Click"/>
                                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="17" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Apps.Count, StringFormat={}{0} แอพ}" FontSize="13"
                                                   Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- ปุ่มเปิดทั้งหมด -->
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}"
                                        Click="LaunchMode_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="เปิดทั้งหมด"/>
                                    </StackPanel>
                                </Button>

                                <!-- ไอคอนแอพในโหมด กดเพื่อเปิดทีละตัว -->
                                <Grid Margin="0,16" MinHeight="44">
                                    <ItemsControl ItemsSource="{Binding Apps}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:AppEntry}">
                                                <Button Style="{StaticResource IconButton}" Width="44" Height="44"
                                                        Margin="0,0,4,4" ToolTip="{Binding Name}" Click="LaunchApp_Click">
                                                    <Image Source="{Binding IconSource, Converter={StaticResource PathToIcon}}"
                                                           Width="28" Height="28"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="ยังไม่มีแอพ กดปุ่มแก้ไขเพื่อเพิ่ม" FontSize="13"
                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Apps.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
