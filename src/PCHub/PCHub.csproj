<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms ใช้แค่ NotifyIcon (ไอคอนมุมจอ) -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PCHub</AssemblyName>
    <Product>PC Hub</Product>
    <Version>0.1.0</Version>
    <!-- ไอคอนของไฟล์ .exe (Desktop, Explorer, Start Menu) สร้างด้วย tools\make-icon.ps1 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- กันชื่อชนกันระหว่าง WPF กับ WinForms (เช่น Application, Button) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
