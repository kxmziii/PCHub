<Window x:Class="PCHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PCHub.Views"
        Title="PC Hub" Icon="/Assets/app.ico" Height="720" Width="1000" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        FontFamily="{StaticResource BodyFont}" FontSize="14"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Background="{StaticResource WindowBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== เมนูด้านซ้าย ===== -->
        <Border Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,22,14,16">

                <!-- โลโก้ -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,30">
                    <Image Source="/Assets/logo.png" Width="38" Height="38"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PC Hub" FontFamily="{StaticResource HeadingFont}" FontSize="19"/>
                        <TextBlock Text="ผู้ช่วยใช้คอมของคุณ" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ล่างสุด: ตั้งค่า + เวอร์ชัน -->
                <StackPanel DockPanel.Dock="Bottom">
                    <!-- การ์ดเซสชันเล่นเกม (โผล่เมื่อกดเล่นเกมจากคลังเกม) -->
                    <Border x:Name="SessionCard" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SessionDot" Width="8" Height="8" Margin="0,0,8,0"
                                         VerticalAlignment="Center" Fill="{StaticResource Success}"/>
                                <TextBlock x:Name="SessionStatus" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <TextBlock x:Name="SessionGame" FontSize="14" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SessionTime" FontFamily="{StaticResource HeadingFont}" FontSize="22"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="SessionNote" FontSize="12" Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                            <Button x:Name="SessionButton" Style="{StaticResource SecondaryButton}" Padding="12,6"
                                    Click="SessionButton_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- แจ้งว่ามีเวอร์ชันใหม่ (โหลดไว้แล้ว จะติดตั้งตอนปิดโปรแกรม) -->
                    <Border x:Name="UpdateCard" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12"
                            BorderBrush="{StaticResource Accent}" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0"
                                           Foreground="{StaticResource Accent}"/>
                                <TextBlock x:Name="UpdateTitle" FontSize="13.5"/>
                            </StackPanel>
                            <TextBlock FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                                       Text="โหลดไว้แล้ว จะอัปเดตเองตอนปิดโปรแกรม"/>
                            <Button Style="{StaticResource PrimaryButton}" Padding="12,6" Content="รีสตาร์ทเลย"
                                    Click="RestartForUpdate_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- ป้ายปิงไปเซิร์ฟสิงคโปร์ อัปเดตทุกนาที -->
                    <Button x:Name="PingBadge" Style="{StaticResource SubtleButton}" Margin="0,0,0,4"
                            ToolTip="ปิงไปเซิร์ฟเวอร์สิงคโปร์ (อัปเดตทุกนาที) กดเพื่อดูละเอียด" Click="PingBadge_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PingDot" Width="8" Height="8" Margin="2,0,14,0" VerticalAlignment="Center"
                                     Fill="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="PingText" Text="กำลังวัดปิง..."/>
                        </StackPanel>
                    </Button>
                    <views:NavButton x:Name="NavSettings" Tag="settings" Icon="&#xE713;" Content="ตั้งค่า"
                                     Checked="Nav_Checked"/>
                    <TextBlock x:Name="VersionText" Margin="14,10,0,0" FontSize="12"
                               Foreground="{StaticResource TextMuted}"/>
                </StackPanel>

                <!-- เมนูหลัก -->
                <StackPanel>
                    <views:NavButton x:Name="NavGames" Tag="games" Icon="&#xE7FC;" Content="คลังเกม"
                                     Checked="Nav_Checked"/>
                    <views:NavButton x:Name="NavDeals" Tag="deals" Icon="&#xE719;" Content="ของฟรี &amp; ลดราคา"
                                     Checked="Nav_Checked"/>
                    <views:NavButton x:Name="NavWrapped" Tag="wrapped" Icon="&#xE9D2;" Content="Gaming Wrapped"
                                     Checked="Nav_Checked"/>
                    <views:NavButton x:Name="NavModes" Tag="modes" Icon="&#xE945;" Content="โหมด &amp; เปิดแอพ"
                                     Checked="Nav_Checked"/>
                    <views:NavButton x:Name="NavCleaner" Tag="cleaner" Icon="&#xE74D;" Content="ลบขยะ"
                                     Checked="Nav_Checked"/>
                    <views:NavButton x:Name="NavDiscord" Tag="discord" Icon="&#xE8BD;" Content="Discord"
                                     Checked="Nav_Checked"/>
                    <views:NavButton x:Name="NavTools" Tag="tools" Icon="&#xE90F;" Content="เครื่องมือ"
                                     Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== พื้นที่แสดงแต่ละหน้า ===== -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="36,30,24,24" Focusable="False"/>
    </Grid>
</Window>
